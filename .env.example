# 项目环境变量配置；可复制 .env.example 到仓库根目录的 .env，或运行 node scripts/setup-dev.js 初始化。
# 按实际读取配置的模块分组；多个模块共用的配置集中列出。
# 本文件配置应用进程和前端网关模板；Docker 容器配置见 deploy/compose.dev.yaml。
# 已有的进程环境变量优先于 .env；相对路径基于进程工作目录，初始化脚本会写入绝对路径。

# ============================================================================
# 公共配置：日志（身份中心、RP 后端、钱包、issuer-db 数据库工具）
# ============================================================================
# 上述 Rust 进程的日志过滤规则；可按模块调整为 debug/trace，Salvo 访问日志需显式启用 salvo_extra::logging=info。
RUST_LOG=warn,salvo_extra::logging=info,issuer_service=info,crypto_sso_relying_party=info,wallet_lib=info

# ============================================================================
# 公共配置：HTTP 与 Cookie（身份中心后端、RP 后端）
# ============================================================================
# 只允许HTTPS传输Cookie；开发时可关闭，生产环境必须开启。
COOKIE_SECURE=false
# 身份中心 API 与 RP 证明提交接口允许的请求体大小上限，单位：字节。
HTTP_BODY_LIMIT_BYTES=1048576

# ============================================================================
# 公共配置：SDK 属性限制（身份中心、钱包、RP 后端）
# ============================================================================
# 三个应用分别初始化 issuer、holder、verifier SDK 时使用的属性数量上限，建议保持一致。
SDK_MAX_CLAIMS=128
# 三个应用使用的 SDK 属性名称长度上限，单位：UTF-8 字节，建议保持一致。
SDK_MAX_KEY_BYTES=64
# 三个应用使用的 SDK 属性值长度上限，单位：UTF-8 字节，建议保持一致。
SDK_MAX_VALUE_BYTES=1024

# ============================================================================
# 身份中心后端：issuer-service
# ============================================================================
# 身份中心后端及 issuer-db 数据库工具使用的 PostgreSQL 连接地址。
DATABASE_URL=postgresql://crypto_sso:crypto_sso_dev@127.0.0.1:5432/crypto_sso
# HTTP Session（中心及 RP 示例）和管理会话/CSRF 密钥存于 Redis，键使用 issuer_service 前缀。
REDIS_URL=redis://127.0.0.1:6379/0
# 身份中心 HTTP 服务监听的 IP 地址和端口。
ISSUER_BIND=127.0.0.1:3000
# 身份中心后台签发任务的轮询间隔，单位：毫秒，必须大于 0。
ISSUER_WORKER_INTERVAL_MS=1000
# 身份中心后台签发任务的租约时长，单位：秒；用于识别和回收超时任务。
ISSUER_LEASE_SECONDS=120
# 管理 API 允许的浏览器来源列表，格式为 JSON 字符串数组；应包含实际管理前端来源，无路径及末尾斜杠。
ADMIN_ALLOWED_ORIGINS_JSON='["http://127.0.0.1:3000","http://127.0.0.1:5173"]'
# 管理员会话的有效时长，单位：秒，必须大于 0。
ADMIN_SESSION_TTL_SECONDS=28800

# ============================================================================
# 管理前端开发服务器：issuer-service-webui（Vite）
# ============================================================================
# 管理前端 Vite 开发服务器的监听主机。
ADMIN_DEV_HOST=127.0.0.1
# 管理前端 Vite 开发服务器的监听端口。
ADMIN_DEV_PORT=5173
# 管理前端 Vite 将 /api 请求代理到的身份中心后端地址，代理检查脚本也读取此项。
ISSUER_API_TARGET=http://127.0.0.1:3000

# ============================================================================
# 管理前端生产网关：deploy/nginx.admin.conf.template
# ============================================================================
# 管理前端 Nginx 网关的监听端口；渲染部署模板时使用。
FRONTEND_LISTEN_PORT=80
# 管理前端 Nginx 网关的域名，应将对应的浏览器来源加入 ADMIN_ALLOWED_ORIGINS_JSON。
FRONTEND_SERVER_NAME=identity.example.org
# 管理前端 Nginx 的静态资源根目录，前端构建产物应放在该目录的 admin 子目录。
FRONTEND_STATIC_ROOT=/usr/share/nginx/html
# 管理前端 Nginx 将 /api/ 请求转发到的身份中心后端地址。
ISSUER_API_UPSTREAM=http://issuer-service:3000

# ============================================================================
# 钱包桌面端：wallet/src-tauri（存储、网络与同步）
# ============================================================================
# 钱包 Rust 后端保存本地受保护钱包数据的目录。
WALLET_DATA_DIR=.dev-data/wallet
# 钱包请求身份中心等 HTTP 接口的超时时间，单位：秒，必须大于 0。
WALLET_HTTP_TIMEOUT_SECONDS=15
# 钱包 HTTP 客户端允许读取的响应体大小上限，单位：字节，必须大于 0。
WALLET_HTTP_BODY_LIMIT_BYTES=1048576
# 钱包后台检查待同步申请的循环间隔，单位：秒；每条申请另按服务端轮询间隔与重试退避调度。
WALLET_SYNC_INTERVAL_SECONDS=1

# ============================================================================
# 钱包前端开发服务器：wallet（Vite）
# ============================================================================
# 钱包前端 Vite 开发服务器的监听主机；Tauri 提供 TAURI_DEV_HOST 时优先使用后者。
WALLET_DEV_HOST=127.0.0.1
# 钱包前端 Vite 开发服务器的监听端口。
WALLET_DEV_PORT=1420

# ============================================================================
# RP 示例应用后端：examples/relying-party（独立验证与应用会话）
# ============================================================================
# RP 后端使用的独立 PostgreSQL 数据库连接地址，保存挑战、会话等数据。
RP_DATABASE_URL=postgresql://crypto_sso:crypto_sso_dev@127.0.0.1:5432/crypto_sso_demo
# RP 后端 HTTP 服务监听的 IP 地址和端口。
RP_BIND=127.0.0.1:3001
# RP 应用的浏览器来源，用于证明绑定和请求来源校验；开发时应与 RP 前端地址一致，无路径及末尾斜杠。
RP_ORIGIN=http://127.0.0.1:5174
# RP 验证器读取的受信任身份中心公钥 JSON 文件路径，用于本地验证证明。
RP_ISSUER_PUBLIC_PATH=.dev-data/issuer-public.json
# RP 会话密钥，至少 64 字节；应使用独立随机值，与管理会话密钥分别配置。
RP_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_64_BYTE_SECRET
# RP 登录 API 的 CSRF 防护密钥，32 字节，以 64 位十六进制字符表示。
RP_CSRF_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_KEY
# RP 浏览器会话和应用登录会话的有效时长，单位：秒。
RP_SESSION_TTL_SECONDS=3600
# RP 登录挑战要求披露的属性名称列表，格式为 JSON 字符串数组。
RP_REQUIRED_CLAIMS_JSON='["role"]'
# RP 在证明验证成功后检查的属性键值策略，格式为 JSON 对象；实际披露值必须满足各项要求。
RP_CLAIM_POLICY_JSON='{"role":"member"}'

# ============================================================================
# RP 示例应用前端开发服务器：examples/relying-party/web（Vite）
# ============================================================================
# RP 前端 Vite 开发服务器的监听主机。
RP_DEV_HOST=127.0.0.1
# RP 前端 Vite 开发服务器的监听端口。
RP_DEV_PORT=5174
# RP 前端 Vite 将 /api 请求代理到的 RP 后端地址。
RP_API_TARGET=http://127.0.0.1:3001

# ============================================================================
# 集成测试：身份中心 Redis、事务与迁移测试、RP 端到端测试
# ============================================================================
# 上述集成测试使用的 PostgreSQL 连接地址；应使用独立、可清理的测试数据库。
TEST_DATABASE_URL=postgresql://crypto_sso:crypto_sso_dev@127.0.0.1:5432/crypto_sso_test
# Redis 密钥测试及初始化、RP 端到端测试使用的独立 Redis 逻辑库。
TEST_REDIS_URL=redis://127.0.0.1:6379/1
